# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/hotel_menu?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Auth ---
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# --- CORS: comma-separated list of the 3 independent frontend origins ---
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
# In production:
# ALLOWED_ORIGINS="https://adama.com,https://menu.adama.com,https://admin.adama.com"

# --- File uploads (local disk by default; swap for S3/Supabase storage later) ---
UPLOAD_DIR="uploads"
PUBLIC_BASE_URL="http://localhost:4000"

# --- Seed data ---
SEED_HOTEL_NAME="Adama Hotel"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="ChangeMe123!"
